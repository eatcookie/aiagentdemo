# ============================================================
# 本地环境变量模板（本文件不含真实密钥，可安全提交到公开仓库）
# 用途：项目推到公开仓库后，所有密钥只存在于每位开发者的本机环境，不进 Git。
# ============================================================
#
# ── 应用运行所需（Spring Boot 读取）────────────────────────────
# 方式 A：IntelliJ IDEA → Run/Debug Configurations → Environment variables 填入：
#   DASHSCOPE_API_KEY=sk-xxxx;MYSQL_PASSWORD=xxxx;SPRING_ELASTICSEARCH_PASSWORD=xxxx
# 方式 B：PowerShell 会话中设置后再启动应用：
#   $env:DASHSCOPE_API_KEY='sk-xxxx'
#   $env:MYSQL_PASSWORD='xxxx'
#   $env:SPRING_ELASTICSEARCH_PASSWORD='xxxx'
#
# ── scripts/reingest-and-test.ps1 删索引(-RecreateIndex)所需 ──
#   $env:AI_ES_USER='newadmin'
#   $env:AI_ES_PASS='xxxx'
#
# ── 变量清单（值请替换为你本机的真实值，勿把真实值写回本文件）──
DASHSCOPE_API_KEY=change-me
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
SPRING_ELASTICSEARCH_USERNAME=newadmin
SPRING_ELASTICSEARCH_PASSWORD=change-me
AI_ES_USER=newadmin
AI_ES_PASS=change-me
