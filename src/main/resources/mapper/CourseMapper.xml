<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiagentdemo.mapper.CourseMapper">
    <select id="findAll" resultType="Course">
        SELECT id, name, teacher FROM t_course
    </select>

    <!-- 依赖 t_course.category 列；不存在时先执行：
         ALTER TABLE t_course ADD COLUMN category VARCHAR(50) DEFAULT NULL COMMENT '课程分类'; -->
    <select id="search" resultType="Course">
        SELECT id, name, teacher, category
        FROM t_course
        <where>
            <if test="keyword != null and keyword != ''">
                (name LIKE CONCAT('%', #{keyword}, '%') OR category LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY id
        LIMIT 20
    </select>
</mapper>